{
  "name": "jobs-server",
  "version": "1.0.0",
  "description": "REST API for the jobs board: authentication, job listings and applications.",
  "license": "MIT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,prisma,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,prisma,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"./{src,prisma,tests}/**/*.ts\"",
    "format:check": "prettier --check \"./{src,prisma,tests}/**/*.ts\"",
    "test": "mocha",
    "migrate": "prisma migrate deploy",
    "seed": "prisma db seed",
    "benchmark": "ts-node scripts/benchmarkListing.ts"
  },
  "dependencies": {
    "@prisma/client": "5.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.18.2",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/chai": "^4.3.5",
    "@types/cors": "^2.8.13",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mocha": "^10.0.1",
    "@types/morgan": "^1.9.4",
    "@types/node": "18.16.19",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "chai": "^4.3.7",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "5.0.0",
    "supertest": "^6.3.3",
    "ts-node": "10.9.1",
    "typescript": "5.1.6"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
