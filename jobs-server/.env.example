# Port the API listens on.
PORT=8080

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://root:root@localhost:5432/jobs-db"

# Secret used to sign and verify JWTs. REQUIRED — the server refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_KEY=""

# Origin allowed by CORS. This is where the React client runs.
REACT_APP_URL="http://localhost:3000"

# Job listing page size, and the ceiling a client may request.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Optional. When set, `yarn test` runs against this database instead of DATABASE_URL, so
# the suite cannot leave fixture rows in your development data.
TEST_DATABASE_URL="postgresql://root:root@localhost:5432/jobs-db-test"
