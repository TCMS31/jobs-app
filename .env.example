# Used by docker compose. Copy to .env before `docker compose up`.
# Each service also has its own .env.example for running without Docker.

POSTGRES_USER=jobs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs-db

# REQUIRED. The API will not start without it. Generate with: openssl rand -hex 32
JWT_KEY=

# Host ports.
API_PORT=8080
WEB_PORT=3000

# Where the browser reaches the API, and the origin the API accepts requests from.
PUBLIC_API_URL=http://localhost:8080/api
WEB_ORIGIN=http://localhost:3000
